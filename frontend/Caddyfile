{
	admin off
}

:5175 {
	handle /api/* {
		reverse_proxy {$RAG_FEEDER_BACKEND_UPSTREAM:rag_backend:4000}
	}

	handle {
		root * /srv
		encode zstd gzip
		# Hashed build assets never change; index.html must be revalidated so a
		# redeploy is picked up instead of pointing at removed assets.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		file_server
	}

	# file_server raises 404 as an error, after the /assets/* header above was
	# set. Without this, a request for an asset missing mid-deploy would be
	# cached as a 404 for a year.
	handle_errors {
		header Cache-Control "no-cache"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
